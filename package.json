    "three": "^0.170.0",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.19.0",
    "postprocessing": "^6.36.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.170.0",
    "typescript": "^5.6.0"
  }
